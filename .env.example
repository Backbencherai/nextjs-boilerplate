# Supabase (optional — the app runs in local-only mode without these). Public values: safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# NEVER put a service_role / secret key in any NEXT_PUBLIC_* variable or in client code.

# AI assistant (optional, server-side only)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
